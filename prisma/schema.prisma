// =============================================================================
// ATELIER — Prisma Schema (PostgreSQL)
// Premium streetwear e-commerce backend. Clean, normalized, indexed for scale.
// =============================================================================

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
  EDITOR
  MANAGER
  SUPER_ADMIN
}

enum Gender {
  MEN
  WOMEN
  UNISEX
  KIDS
}

enum ProductStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
  DELETED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  REVERSED
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  MANUAL
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  USSD
  MOBILE_MONEY
  CASH
  MANUAL
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  BACKORDER
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
  BUY_X_GET_Y
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationType {
  ORDER_PLACED
  PAYMENT_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  PASSWORD_RESET
  WELCOME_EMAIL
  EMAIL_VERIFICATION
  LOW_STOCK_ALERT
  ORDER_CANCELLED
  REFUND_ISSUED
  MARKETING
}

enum NotificationStatus {
  PENDING
  QUEUED
  SENT
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

enum MediaType {
  IMAGE
  VIDEO
  THUMBNAIL
  ZOOM
  GALLERY
  THREE_SIXTY
}

enum FileKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  VERIFY
  STATUS_CHANGE
  EXPORT
}

enum ShippingZoneType {
  REGION
  COUNTRY
  CITY
  GLOBAL
}

enum ShippingCalculationType {
  FLAT
  WEIGHT_BASED
  LOCATION_BASED
  FREE
  PICKUP
}

enum HomepageSectionType {
  HERO_BANNER
  ANNOUNCEMENT_BAR
  FEATURED_COLLECTIONS
  FEATURED_PRODUCTS
  NEW_ARRIVALS
  EDITORIAL
  INSTAGRAM_GALLERY
  TESTIMONIALS
  NEWSLETTER
  PROMOTIONAL_BANNER
  FOOTER_LINK
  NAVIGATION
}

enum HomepageSectionStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum CartStatus {
  ACTIVE
  MERGED
  CHECKED_OUT
  ABANDONED
  EXPIRED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum OAuthProvider {
  GOOGLE
}

enum AddressType {
  SHIPPING
  BILLING
}

enum OrderEventType {
  STATUS_CHANGE
  PAYMENT
  NOTE
  FULFILLMENT
  REFUND
}

enum MovementType {
  PURCHASE
  SALE
  RESERVATION
  RESERVATION_RELEASE
  ADJUSTMENT
  RETURN
  TRANSFER
  DAMAGED
}

// ---------------------------------------------------------------------------
// AUTH & USERS
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String?
  firstName         String?
  lastName          String?
  phone             String?
  avatarUrl         String?
  role              Role      @default(CUSTOMER)
  isEmailVerified   Boolean   @default(false)
  emailVerifiedAt   DateTime?
  isActive          Boolean   @default(true)
  locale            String    @default("en")
  currency          String    @default("NGN")
  twoFactorEnabled  Boolean   @default(false)
  lastLoginAt       DateTime?
  lastLoginIp       String?
  googleId          String?   @unique
  marketingOptIn    Boolean   @default(true)
  passwordChangedAt DateTime?

  addresses        Address[]
  sessions         Session[]
  refreshTokens    RefreshToken[]
  oauthAccounts    OAuthAccount[]
  orders           Order[]
  cart             Cart?
  wishlistItems    WishlistItem[]
  reviews          Review[]
  reviewLikes      ReviewLike[]
  reviewReports    ReviewReport[]
  couponRedemptions CouponRedemption[]
  notificationPreferences NotificationPreference[]
  notifications    Notification[]
  searchQueries    SearchQuery[]
  auditLogs        AuditLog[]   @relation("auditor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([createdAt])
  @@index([email])
}

model OAuthAccount {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     OAuthProvider
  providerId   String
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?

  @@unique([provider, providerId])
  @@index([userId])
}

model Session {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String        @unique
  refreshTokenId String?
  ipAddress    String?
  userAgent    String?
  status       SessionStatus @default(ACTIVE)
  expiresAt    DateTime
  lastUsedAt   DateTime      @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([token])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  revokedAt DateTime?
  replacedBy String?
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  type      String // EMAIL_VERIFICATION | PASSWORD_RESET
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// ADDRESSES
// ---------------------------------------------------------------------------

model Address {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String? // Home, Work, etc
  type        AddressType
  firstName   String
  lastName    String
  phone       String?
  line1       String
  line2       String?
  city        String
  state       String
  postalCode  String?
  country     String      @default("NG")
  isDefault   Boolean     @default(false)
  isVerified  Boolean     @default(false)
  lat         Float?
  lng         Float?

  ordersShipping   Order[] @relation("shippingAddress")
  ordersBilling    Order[] @relation("billingAddress")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([country, city])
}

// ---------------------------------------------------------------------------
// CATALOG
// ---------------------------------------------------------------------------

model Category {
  id          String    @id @default(cuid())
  parentId    String?
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  bannerUrl   String?
  iconUrl     String?
  metaTitle   String?
  metaDescription String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  isFeatured  Boolean   @default(false)

  products    ProductCategory[]
  collections Collection[] // collections may link a root category

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([slug])
  @@index([isActive, isFeatured])
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  bannerUrl   String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  metaTitle   String?
  metaDescription String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  isFeatured  Boolean   @default(false)
  publishAt   DateTime?
  unpublishAt DateTime?
  badge       String? // "Limited", "Drop", "New"

  products    CollectionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isActive, isFeatured])
}

model CollectionProduct {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)

  @@id([collectionId, productId])
  @@index([productId])
}

model Product {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  shortDescription String?
  longDescription String?
  brand           String?
  gender          Gender?
  tags            String[]       @default([])
  sku             String         @unique
  barcode         String?
  weightKg        Decimal        @default(0) @db.Decimal(10, 3)
  lengthCm        Decimal?
  widthCm         Decimal?
  heightCm        Decimal?

  metaTitle       String?
  metaDescription String?
  metaKeywords    String?

  status          ProductStatus  @default(DRAFT)
  publishAt       DateTime?
  publishedAt     DateTime?
  archivedAt      DateTime?
  deletedAt       DateTime?

  materials       String?
  careInstructions String?
  fit             String?

  basePrice       Decimal @db.Decimal(12, 2)
  compareAtPrice  Decimal? @db.Decimal(12, 2)
  costPrice       Decimal? @db.Decimal(12, 2)
  currency        String  @default("NGN")
  rating          Decimal @default(0) @db.Decimal(3, 2)
  reviewCount     Int     @default(0)
  totalSold       Int     @default(0)
  viewCount       Int     @default(0)

  // Product flags
  isFeatured      Boolean @default(false)
  isBestSeller    Boolean @default(false)
  isTrending      Boolean @default(false)
  isNewArrival    Boolean @default(false)
  isLimitedEdition Boolean @default(false)

  createdBy       String?
  updatedBy       String?

  images          ProductImage[]
  variants        ProductVariant[]
  categories      ProductCategory[]
  collections     CollectionProduct[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  searchQueries   SearchQuery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishAt])
  @@index([status, isFeatured])
  @@index([status, isBestSeller])
  @@index([status, isNewArrival])
  @@index([status, isTrending])
  @@index([isLimitedEdition])
  @@index([sku])
  @@index([slug])
  @@index([createdAt])
  @@index([name])
  @@index([gender])
  @@index([brand])
  @@index([totalSold])
}

model ProductVariant {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String    @unique
  barcode      String?
  color        String?
  size         String?
  price        Decimal   @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  costPrice    Decimal?  @db.Decimal(12, 2)
  weightKg     Decimal   @default(0) @db.Decimal(10, 3)
  isActive     Boolean   @default(true)
  isDefault    Boolean   @default(false)
  imageUrl     String?
  attributes   Json?

  inventory    Inventory?
  inventoryHistory InventoryHistory[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, color, size])
  @@index([productId])
  @@index([sku])
  @@index([color, size])
}

model ProductImage {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  thumbUrl  String?
  zoomUrl   String?
  videoUrl  String?
  altText   String?
  kind      MediaType @default(GALLERY)
  sortOrder Int       @default(0)
  isThumbnail Boolean @default(false)
  width     Int?
  height    Int?
  sizeBytes Int?
  cloudKey  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([productId, sortOrder])
}

model ProductCategory {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)

  @@id([productId, categoryId])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// INVENTORY
// ---------------------------------------------------------------------------

model Warehouse {
  id        String  @id @default(cuid())
  name      String
  code      String  @unique
  address   String?
  city      String?
  country   String  @default("NG")
  isActive  Boolean @default(true)

  inventory Inventory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Inventory {
  id              String       @id @default(cuid())
  variantId       String       @unique
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseId     String?
  warehouse       Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  quantity        Int          @default(0)
  reserved        Int          @default(0)
  incoming        Int          @default(0)
  lowStockThreshold Int        @default(5)
  reorderPoint    Int          @default(0)
  allowBackorder  Boolean      @default(false)
  status          StockStatus  @default(IN_STOCK)

  history         InventoryHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([quantity, lowStockThreshold])
  @@index([warehouseId])
}

model InventoryHistory {
  id        String       @id @default(cuid())
  inventoryId String
  inventory Inventory    @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  movementType MovementType
  quantityChange Int
  quantityBefore Int
  quantityAfter  Int
  referenceType String? // ORDER, PURCHASE_ORDER, ADJUSTMENT, etc
  referenceId  String?
  note        String?
  createdById String?

  createdAt DateTime @default(now())

  @@index([inventoryId])
  @@index([variantId])
  @@index([createdAt])
  @@index([movementType])
}

model LowStockAlert {
  id         String   @id @default(cuid())
  variantId  String
  productId  String
  sku        String
  currentQty Int
  threshold  Int
  resolved   Boolean  @default(false)
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resolved])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// CART
// ---------------------------------------------------------------------------

model Cart {
  id           String     @id @default(cuid())
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestId      String?
  token        String     @unique
  status       CartStatus @default(ACTIVE)
  currency     String     @default("NGN")
  couponCode   String?
  shippingCountry String?
  shippingRegion  String?
  shippingMethodId String?
  expiresAt    DateTime?

  items        CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
  @@index([guestId])
  @@index([token])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(12, 2)
  couponApplied Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
  @@index([cartId])
}

// ---------------------------------------------------------------------------
// ORDERS
// ---------------------------------------------------------------------------

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  email           String
  phone           String?

  status          OrderStatus @default(PENDING)
  currency        String      @default("NGN")

  subtotal        Decimal     @db.Decimal(12, 2)
  discountTotal   Decimal     @default(0) @db.Decimal(12, 2)
  shippingTotal   Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal     @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal     @db.Decimal(12, 2)
  amountPaid      Decimal     @default(0) @db.Decimal(12, 2)

  shippingAddressId String?
  shippingAddress   Address?   @relation("shippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddressId  String?
  billingAddress    Address?   @relation("billingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  shippingAddressSnapshot Json?
  billingAddressSnapshot  Json?

  couponId        String?
  coupon          Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode      String?
  couponDiscount  Decimal     @default(0) @db.Decimal(12, 2)

  shippingMethodId String?
  shippingMethod  ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  shippingZoneId  String?
  trackingNumber  String?
  courier         String?

  customerNote    String?
  adminNote       String?
  ipAddress       String?
  userAgent       String?
  isGuest         Boolean     @default(false)
  source          String      @default("web")

  placedAt        DateTime    @default(now())
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  cancelledReason String?
  refundedAt      DateTime?

  items           OrderItem[]
  payments        Payment[]
  timeline        OrderTimeline[]
  auditLogs       AuditLog[]
  reviews         Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([placedAt])
  @@index([orderNumber])
}

model OrderItem {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  variantLabel String?
  sku         String
  imageUrl    String?
  unitPrice   Decimal   @db.Decimal(12, 2)
  quantity    Int
  discount    Decimal   @default(0) @db.Decimal(12, 2)
  totalPrice  Decimal   @db.Decimal(12, 2)
  color       String?
  size        String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderTimeline {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventType OrderEventType
  fromStatus OrderStatus?
  toStatus  OrderStatus?
  description String
  metadata  Json?
  createdById String?

  createdAt DateTime @default(now())

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// PAYMENTS
// ---------------------------------------------------------------------------

model Payment {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider       PaymentProvider
  method         PaymentMethod?
  reference      String          @unique
  externalRef    String?         // paystack/flutterwave reference
  status         PaymentStatus   @default(PENDING)
  amount         Decimal         @db.Decimal(12, 2)
  currency       String          @default("NGN")
  fee            Decimal?        @db.Decimal(12, 2)
  paidAt         DateTime?
  failureReason  String?
  authorization  Json?
  meta           Json?
  retryCount     Int             @default(0)
  lastVerifiedAt DateTime?

  logs           PaymentLog[]
  refunds        Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([reference])
  @@index([status])
  @@index([provider])
}

model PaymentLog {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  event     String
  message   String?
  payload   Json?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([paymentId])
}

model Refund {
  id         String          @id @default(cuid())
  paymentId  String
  payment    Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderId    String
  reference  String          @unique
  amount     Decimal         @db.Decimal(12, 2)
  reason     String?
  status     PaymentStatus   @default(PENDING)
  externalRef String?
  meta       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([orderId])
  @@index([reference])
}

// ---------------------------------------------------------------------------
// COUPONS
// ---------------------------------------------------------------------------

model Coupon {
  id                 String     @id @default(cuid())
  code               String     @unique
  type               CouponType
  value              Decimal    @db.Decimal(12, 2) // percentage or fixed amount
  maxDiscountAmount  Decimal?   @db.Decimal(12, 2)
  minPurchaseAmount  Decimal?   @db.Decimal(12, 2)
  freeShippingOnly   Boolean    @default(false)
  buyXGetYBuy        Int?
  buyXGetYGet        Int?

  isActive           Boolean    @default(true)
  startsAt           DateTime?
  expiresAt          DateTime?
  usageLimit         Int?
  perUserLimit       Int?
  usedCount          Int        @default(0)
  appliesTo          String     @default("ALL") // ALL | CATEGORY | COLLECTION | PRODUCT
  applicableIds      String[]   @default([])

  isSingleUse        Boolean    @default(false)
  isStackable        Boolean    @default(false)
  customerEmails     String[]   @default([])

  orders             Order[]
  redemptions        CouponRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([isActive, expiresAt])
  @@index([type])
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  discountApplied Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([userId])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// SHIPPING
// ---------------------------------------------------------------------------

model ShippingZone {
  id        String           @id @default(cuid())
  name      String
  type      ShippingZoneType @default(COUNTRY)
  countries String[]         @default([])
  regions   String[]         @default([])
  cities    String[]         @default([])
  isActive  Boolean          @default(true)

  methods   ShippingMethod[]
  rules     ShippingRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model ShippingMethod {
  id        String               @id @default(cuid())
  name      String
  code      String               @unique
  zoneId    String
  zone      ShippingZone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  type      ShippingCalculationType @default(FLAT)
  baseRate  Decimal              @default(0) @db.Decimal(12, 2)
  freeAbove Decimal?             @db.Decimal(12, 2) // free shipping above subtotal
  minWeight Decimal?             @db.Decimal(10, 3)
  maxWeight Decimal?             @db.Decimal(10, 3)
  ratePerKg Decimal?             @db.Decimal(12, 2)
  estimatedDaysMin Int?
  estimatedDaysMax Int?
  isActive  Boolean              @default(true)
  isPickup  Boolean              @default(false)
  sortOrder Int                  @default(0)

  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([isActive])
}

model ShippingRule {
  id        String    @id @default(cuid())
  zoneId    String
  zone      ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name      String
  priority  Int       @default(0)
  minSubtotal Decimal? @db.Decimal(12, 2)
  maxSubtotal Decimal? @db.Decimal(12, 2)
  minWeight Decimal?  @db.Decimal(10, 3)
  maxWeight Decimal?  @db.Decimal(10, 3)
  charge    Decimal   @db.Decimal(12, 2)
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
}

// ---------------------------------------------------------------------------
// WISHLIST & REVIEWS
// ---------------------------------------------------------------------------

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

model Review {
  id         String       @id @default(cuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId    String?
  order      Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rating     Int
  title      String?
  body       String?
  isVerified Boolean      @default(false)
  status     ReviewStatus @default(PENDING)
  helpfulCount Int        @default(0)
  images     String[]     @default([])

  likes      ReviewLike[]
  reports    ReviewReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, status])
  @@index([userId])
  @@index([isVerified])
}

model ReviewLike {
  id        String @id @default(cuid())
  reviewId  String
  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
}

model ReviewReport {
  id        String @id @default(cuid())
  reviewId  String
  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  status    String @default("PENDING")

  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
}

// ---------------------------------------------------------------------------
// MEDIA
// ---------------------------------------------------------------------------

model MediaAsset {
  id          String    @id @default(cuid())
  filename    String
  originalName String
  mimeType    String
  sizeBytes   Int
  width       Int?
  height      Int?
  kind        FileKind  @default(IMAGE)
  url         String
  thumbUrl    String?
  cloudKey    String
  bucket      String
  altText     String?
  folder      String    @default("/")
  checksum    String?
  uploadedById String?
  isOptimized Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folder])
  @@index([kind])
  @@index([uploadedById])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// CMS / HOMEPAGE / SETTINGS
// ---------------------------------------------------------------------------

model HomepageContent {
  id        String                 @id @default(cuid())
  sectionType HomepageSectionType
  sectionKey String                @unique
  title     String?
  subtitle  String?
  content   Json?                  // full editable block, type per section
  status    HomepageSectionStatus  @default(ACTIVE)
  sortOrder Int                    @default(0)
  publishedAt DateTime?
  publishedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionType])
  @@index([status, sortOrder])
}

model StoreSetting {
  id          String @id @default(cuid())
  key         String @unique
  value       Json
  group       String @default("general")
  isSecret    Boolean @default(false)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
}

model AnnouncementBar {
  id        String  @id @default(cuid())
  message   String
  link      String?
  isActive  Boolean @default(true)
  startsAt  DateTime?
  endsAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NavigationItem {
  id        String    @id @default(cuid())
  parentId  String?
  parent    NavigationItem? @relation("NavTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  NavigationItem[] @relation("NavTree")
  label     String
  url       String?
  type      String    @default("CUSTOM") // CUSTOM | CATEGORY | COLLECTION | PRODUCT | PAGE
  refId     String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Page {
  id           String  @id @default(cuid())
  title        String
  slug         String  @unique
  body         String
  metaTitle    String?
  metaDescription String?
  isPublished  Boolean @default(false)
  publishedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS
// ---------------------------------------------------------------------------

model NotificationPreference {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  type      NotificationType
  enabled   Boolean             @default(true)

  @@unique([userId, channel, type])
}

model Notification {
  id         String             @id @default(cuid())
  userId     String?
  user       User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  channel    NotificationChannel
  title      String
  body       String
  data       Json?
  status     NotificationStatus @default(PENDING)
  sentAt     DateTime?
  readAt     DateTime?
  error      String?

  createdAt DateTime @default(now())

  @@index([userId, status])
  @@index([type])
  @@index([createdAt])
}

model OutboundMessage {
  id           String             @id @default(cuid())
  channel      NotificationChannel
  recipient    String
  subject      String?
  content      String
  template     String?
  payload      Json?
  status       NotificationStatus @default(PENDING)
  attempts     Int                @default(0)
  providerId   String?
  sentAt       DateTime?
  error        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([channel])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// AUDIT, ANALYTICS, SEARCH
// ---------------------------------------------------------------------------

model AuditLog {
  id        String  @id @default(cuid())
  actorId   String?
  actor     User?   @relation("auditor", fields: [actorId], references: [id], onDelete: SetNull)
  orderId   String?
  order     Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  action    AuditAction
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  userAgent String?
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([orderId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  event      String // PAGE_VIEW | PRODUCT_VIEW | ADD_TO_CART | CHECKOUT_START | PURCHASE
  userId     String?
  sessionId  String?
  productId  String?
  categoryId String?
  collectionId String?
  orderId    String?
  source     String?
  medium     String?
  referrer   String?
  value      Decimal?
  currency   String?
  meta       Json?
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([productId, event])
  @@index([sessionId])
  @@index([userId])
}

model SearchQuery {
  id        String   @id @default(cuid())
  query     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  results   Int?
  clicked   Boolean  @default(false)
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([query])
  @@index([createdAt])
  @@index([userId])
}
