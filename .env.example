# =============================================================================
# ATELIER — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to version control.
# =============================================================================

# --- App ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000
APP_NAME=ATELIER
API_PREFIX=/api/v1

# --- Security ---
JWT_ACCESS_SECRET=change-me-access-secret-32chars-minimum!!
JWT_REFRESH_SECRET=change-me-refresh-secret-32chars-minimum!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Must match the value used when seeding, or existing password hashes will not verify.
PASSWORD_PEPPER=
BCRYPT_COST=10
CSRF_SECRET=change-me-csrf-secret

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atelier

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=300

# --- S3 / Cloudflare R2 ---
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=atelier-media
S3_PUBLIC_URL=https://cdn.example.com
S3_FORCE_PATH_STYLE=true

# --- Paystack ---
PAYSTACK_SECRET_KEY=pk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_WEBHOOK_SECRET=change-me

# --- Flutterwave ---
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxx
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK-xxx
FLUTTERWAVE_WEBHOOK_SECRET=change-me

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ATELIER <no-reply@example.com>"

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/oauth/google/callback

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=25
IMAGE_COMPRESSION_QUALITY=80

# --- Store settings (optional overrides; DB settings win) ---
DEFAULT_CURRENCY=NGN
DEFAULT_COUNTRY=NG
TAX_RATE_PERCENT=7.5
FREE_SHIPPING_THRESHOLD=150000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Logging ---
LOG_LEVEL=info
